/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://github-readme-stats.vercel.app; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/img/*
  Cache-Control: public, max-age=86400
