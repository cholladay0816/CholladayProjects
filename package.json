{
  "name": "cholladay-projects",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "production": "npm run build",
    "dev": "npm run build && wrangler dev --local",
    "test": "node --test tests/*.test.mjs",
    "test:http": "node scripts/check-http.mjs",
    "check:deploy": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": { "wrangler": "4.157.0" }
}
